{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "../../packages/react/src/*"
      ],
      "@component-template/react": [
        "../../packages/react/src/index.ts"
      ],
      "@component-template/react/styles.css": [
        "../../packages/react/src/styles.css"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/react/src"
  ]
}